<%- include('../partials/header') %>

<div class="page-header">
  <h2><i class="bi bi-pencil-square"></i> Sửa bài viết</h2>
  <a href="/posts" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/posts/edit/<%= post.id %>" method="POST">
      <div class="mb-3">
        <label for="title" class="form-label">Tiêu đề bài viết <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="title" name="title" value="<%= post.title %>" required>
      </div>
      <div class="row mb-3">
        <div class="col-md-4">
          <label for="category_id" class="form-label">Danh mục</label>
          <select class="form-select" id="category_id" name="category_id">
            <option value="">-- Chọn danh mục --</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat.id %>" <%= post.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label for="author_id" class="form-label">Tác giả</label>
          <select class="form-select" id="author_id" name="author_id">
            <% users.forEach(function(user) { %>
              <option value="<%= user.id %>" <%= post.author_id == user.id ? 'selected' : '' %>><%= user.full_name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label for="status" class="form-label">Trạng thái</label>
          <select class="form-select" id="status" name="status">
            <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Xuất bản</option>
            <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Bản nháp</option>
          </select>
        </div>
      </div>
      <div class="mb-3">
        <label for="content" class="form-label">Nội dung <span class="text-danger">*</span></label>
        <textarea class="form-control" id="content" name="content" rows="8" required><%= post.content %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Cập nhật</button>
        <a href="/posts" class="btn btn-outline-primary">Hủy</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
  <h2><i class="bi bi-pencil-square"></i> Sửa danh mục</h2>
  <a href="/categories" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/categories/edit/<%= category.id %>" method="POST">
      <div class="mb-3">
        <label for="name" class="form-label">Tên danh mục <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="name" name="name" value="<%= category.name %>" required>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Mô tả</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= category.description %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Cập nhật</button>
        <a href="/categories" class="btn btn-outline-primary">Hủy</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>

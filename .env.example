# ============================================================
# Biến môi trường mẫu - Blog CMS
# Sinh viên: Hoàng Duy Mạnh - DTC245200060
# ⚠️  Copy file này thành .env và điền mật khẩu thật!
# ============================================================

# ===== MySQL Root =====
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# ===== MySQL Database =====
MYSQL_DATABASE=blog_cms_db

# ===== Blog User (Least Privilege) =====
DB_HOST=mysql
DB_PORT=3306
DB_USER=blog_user
DB_PASSWORD=your_blog_user_password_here
DB_NAME=blog_cms_db

# ===== App Config =====
APP_PORT=3000
SESSION_SECRET=your_session_secret_here

# ===== Grafana =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here

# ===== phpMyAdmin =====
PMA_HOST=mysql
PMA_PORT=3306

# ===== MySQL Exporter =====
MYSQLD_EXPORTER_PASSWORD=your_exporter_password_here
